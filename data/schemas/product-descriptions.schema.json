{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://frontend-engineering-bootcamp.local/schemas/product-descriptions.schema.json",
  "title": "Product descriptions",
  "description": "data/raw/product-descriptions.json: optional marketing content for 72% of products.",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "productId",
      "shortDescription",
      "longDescription",
      "features",
      "material",
      "warrantyMonths",
      "updatedAt"
    ],
    "properties": {
      "productId": {
        "type": "integer",
        "minimum": 1,
        "description": "Unique within this file; references products.csv."
      },
      "shortDescription": {
        "type": "string",
        "minLength": 1
      },
      "longDescription": {
        "type": ["string", "null"]
      },
      "features": {
        "type": "array",
        "items": { "type": "string", "minLength": 1 }
      },
      "material": {
        "type": ["string", "null"]
      },
      "warrantyMonths": {
        "type": ["integer", "null"],
        "enum": [12, 24, 36, null]
      },
      "updatedAt": {
        "type": "string",
        "description": "ISO date for most rows; MM/DD/YYYY for 72 rows."
      }
    }
  }
}
