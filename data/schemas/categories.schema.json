{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://frontend-engineering-bootcamp.local/schemas/categories.schema.json",
  "title": "Categories",
  "description": "data/raw/categories.json: a flat array with a self-referencing parentId hierarchy.",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["id", "name", "slug", "parentId", "description"],
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^CAT-[0-9]{2}$"
      },
      "name": {
        "type": "string",
        "minLength": 1,
        "description": "Display name. CAT-08 has a trailing space and CAT-21 is lowercase."
      },
      "slug": {
        "type": "string",
        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
      },
      "parentId": {
        "type": ["string", "null"],
        "description": "Another category id, or null for a root category.",
        "pattern": "^CAT-[0-9]{2}$"
      },
      "description": {
        "type": "string"
      }
    }
  }
}
