{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://frontend-engineering-bootcamp.local/schemas/reviews.schema.json",
  "title": "Reviews",
  "description": "data/raw/reviews.json: customer reviews with nullable ratings and mixed date formats. Some productId values do not exist in the catalogue.",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "reviewId",
      "productId",
      "rating",
      "title",
      "body",
      "authorName",
      "createdAt",
      "verifiedPurchase",
      "helpfulVotes"
    ],
    "properties": {
      "reviewId": {
        "type": "string",
        "pattern": "^REV-[0-9]{6}$"
      },
      "productId": {
        "type": "integer",
        "minimum": 1,
        "description": "Usually references products.csv; 120 reviews reference unknown ids in the 9000000 range."
      },
      "rating": {
        "type": ["integer", "null"],
        "minimum": 1,
        "maximum": 5
      },
      "title": {
        "type": ["string", "null"]
      },
      "body": {
        "type": ["string", "null"]
      },
      "authorName": {
        "type": "string",
        "minLength": 1
      },
      "createdAt": {
        "type": "string",
        "description": "Mixed formats: ISO date, ISO timestamp, or MM/DD/YYYY / DD/MM/YYYY."
      },
      "verifiedPurchase": {
        "type": "boolean"
      },
      "helpfulVotes": {
        "type": "integer",
        "minimum": 0
      }
    }
  }
}
